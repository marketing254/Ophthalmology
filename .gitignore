# Dependencies / build output
/node_modules
/.next
/out
/build
.vercel

# Environment (contains the Apps Script endpoint; set per deployment)
.env
.env*.local

# Legacy static HTML mockups (superseded by the Next.js app)
/*.html

# Dev scratch scripts (sheet probes / one-off tests)
/scripts/

# Logs & OS/editor noise
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/

# Local deliverables & working docs (keep out of the repo)
*.pdf
*.xlsx

# Build-time sheet snapshot (regenerated every build)
.sheet-cache.json

# UI draft from the product owner's repo (reference only, never commit)
/oba-website-main/

# SEO skill reference files (local tooling, not site code)
/skills/

# Raw asset drops at the root (served copies live in /public)
/*.webp

